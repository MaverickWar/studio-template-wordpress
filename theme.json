{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": { "defaultPalette": false, "defaultGradients": false, "custom": false },
    "typography": { "defaultFontSizes": false, "fluid": true,
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
        { "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.75rem", "max": "2rem" } },
        { "slug": "xx-large", "name": "Huge", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"] },
    "layout": { "contentSize": "720px", "wideSize": "1200px" }
  },
  "styles": {
    "spacing": { "padding": { "left": "var(--wp--preset--spacing--40, 1.5rem)", "right": "var(--wp--preset--spacing--40, 1.5rem)" } },
    "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.1" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
